// Helper function: Prints text vertically letter by letter
void printVertical(int x, int y, String text) {
  for (int i = 0; i < text.length(); i++) {
    // Set cursor: X stays fixed, Y increases by 12 pixels per letter
    display.setCursor(x, y + (i * 12)); 
    display.print(text[i]);
  }
}

