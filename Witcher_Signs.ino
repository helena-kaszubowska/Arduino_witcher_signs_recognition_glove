// --- CALIBRATION DATA ---
const int thumbStraight = 2740; const int thumbBent = 2650;
const int indexStraight = 2620; const int indexBent = 2540;
const int middleStraight = 2660; const int middleBent = 2590;
const int ringStraight = 2670; const int ringBent = 2630;
const int pinkyStraight = 1000; const int pinkyBent = 400;

// Universal thresholds in %
const int bentThreshold = 70;      // Finger considered "bent" at 70%
const int straightThreshold = 30;  // Finger considered "straight" at 30%
const int hysteresisMargin = 10;   // 10% tolerance when holding a sign

enum SignType { NONE, QUEN, AARD, IGNI, AXII, YRDEN, ZARAZA, CURSE, LAMBERT, STORM };
SignType activeSign = NONE;

// Smoothed percentage values (EMA filter memory)
float thumbPercentage = 0, indexPercentage = 0, middlePercentage = 0, 
ringPercentage = 0, pinkyPercentage = 0;

void setup() { 
  Serial.begin(9600);
  pinMode(flexThumb, INPUT);
  pinMode(flexIndex, INPUT);
  pinMode(flexMiddle, INPUT);
  pinMode(flexRing, INPUT);
  pinMode(flexPinky, INPUT);

  // Initialize the primary I2C bus for the OLED screen
  Wire.begin(OLED_SDA, OLED_SCL);
  
  // Initialize the secondary I2C bus for the MPU
  I2C_MPU.begin(MPU_SDA, MPU_SCL);

  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("Error: OLED screen not found!");
  } else {
    Serial.println("OLED Screen - OK");
  }

  // Start the MPU, explicitly telling it to use the secondary bus
  // The default MPU6050 I2C address is 0x68
  if (!mpu.begin(0x68, &I2C_MPU)) {
    Serial.println("Error: MPU6050 not found!");
  } else {
    mpu.setAccelerometerRange(MPU6050_RANGE_8_G);
    mpu.setGyroRange(MPU6050_RANGE_500_DEG);
    mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);
    Serial.println("MPU6050 - OK");
  }
}

void loop() {
  // 1. READ RAW VALUES
  int rawThumb = analogRead(flexThumb);
  int rawIndex = analogRead(flexIndex);
  int rawMiddle = analogRead(flexMiddle);
  int rawRing = analogRead(flexRing);
  int rawPinky = analogRead(flexPinky);

  // Serial.print("Flex thumb sensor: ");
  // Serial.println(rawThumb);
  // Serial.print("Flex index sensor: ");
  // Serial.println(rawIndex);
  // Serial.print("Flex middle sensor: ");
  // Serial.println(rawMiddle);
  // Serial.print("Flex ring sensor: ");
  // Serial.println(rawRing);
  // Serial.print("Flex pinky sensor: ");
  // Serial.println(rawPinky);

  // 2. MAP TO 0-100% AND APPLY EMA FILTER
  // map() handles both increasing and decreasing sensors automatically!
  int targetThumb = constrain(map(rawThumb, thumbStraight, thumbBent, 0, 100), 0, 100);
  int targetIndex = constrain(map(rawIndex, indexStraight, indexBent, 0, 100), 0, 100);
  int targetMiddle = constrain(map(rawMiddle, middleStraight, middleBent, 0, 100), 0, 100);
  int targetRing = constrain(map(rawRing, ringStraight, ringBent, 0, 100), 0, 100);
  int targetPinky = constrain(map(rawPinky, pinkyStraight, pinkyBent, 0, 100), 0, 100);

  // EMA Filtering on percentages (0.1 = smoothness)
  thumbPercentage  = (targetThumb * 0.1)  + (thumbPercentage * 0.9);
  indexPercentage  = (targetIndex * 0.1)  + (indexPercentage * 0.9);
  middlePercentage = (targetMiddle * 0.1) + (middlePercentage * 0.9);
  ringPercentage  = (targetRing * 0.1)   + (ringPercentage * 0.9);
  pinkyPercentage  = (targetPinky * 0.1)  + (pinkyPercentage * 0.9);

  Serial.print("Flex thumb sensor smoothed: ");
  Serial.println(thumbPercentage);
  Serial.print("Flex index sensor smoothed: ");
  Serial.println(indexPercentage);
  Serial.print("Flex middle sensor smoothed: ");
  Serial.println(middlePercentage);
  Serial.print("Flex ring sensor smoothed: ");
  Serial.println(ringPercentage);
  Serial.print("Flex pinky sensor smoothed: ");
  Serial.println(pinkyPercentage);

  // 3. READ MPU DATA
  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);

  Serial.print("Acceleration X: ");
  Serial.print(a.acceleration.x);
  Serial.print(" | Y: ");
  Serial.print(a.acceleration.y);
  Serial.print(" | Z: ");
  Serial.println(a.acceleration.z);

  display.clearDisplay();
  int tolerance = 0; // Current tolerance margin
  SignType detectedThisLoop = NONE;
  
  // QUEN
  tolerance = (activeSign == QUEN) ? hysteresisMargin : 0;
  if (thumbPercentage > (bentThreshold - tolerance) && 
      indexPercentage < (straightThreshold + tolerance) && 
      middlePercentage < (straightThreshold + tolerance) && 
      ringPercentage < (straightThreshold + tolerance) && 
      pinkyPercentage > (bentThreshold - tolerance) &&
      a.acceleration.x > 3 && a.acceleration.z > -5) {
    displayQuen();
    detectedThisLoop = QUEN;
  }

  // AARD
  else {
    tolerance = (activeSign == AARD) ? hysteresisMargin : 0;
    if (thumbPercentage < (straightThreshold + tolerance) && 
        indexPercentage < (straightThreshold + tolerance) && 
        middlePercentage > (bentThreshold - tolerance) && 
        ringPercentage < (straightThreshold + tolerance) && 
        pinkyPercentage < (straightThreshold + tolerance) &&
        a.acceleration.x > 5 && a.acceleration.z > -5) {
      displayAard();
      detectedThisLoop = AARD;
    }

    // IGNI
    else {
      tolerance = (activeSign == IGNI) ? hysteresisMargin : 0;
      if (thumbPercentage < (straightThreshold + tolerance) && 
          indexPercentage > (bentThreshold - tolerance) && 
          middlePercentage < (straightThreshold + tolerance) && 
          ringPercentage < (straightThreshold + tolerance) && 
          pinkyPercentage < (straightThreshold + tolerance + 40) &&
          a.acceleration.x > 5 && a.acceleration.z > -5) {
        displayIgni();
        detectedThisLoop = IGNI;
      }

      // AXII
      else {
        tolerance = (activeSign == AXII) ? hysteresisMargin : 0;
        if (thumbPercentage < (straightThreshold + tolerance) && 
            indexPercentage < (straightThreshold + tolerance) && 
            middlePercentage < (straightThreshold + tolerance) && 
            ringPercentage > (bentThreshold - tolerance) &&
            a.acceleration.x > 3 && a.acceleration.z > -5) {
          displayAxii();
          detectedThisLoop = AXII;
        }

        // YRDEN (Same fingers as Aard, different MPU orientation)
        else {
          tolerance = (activeSign == YRDEN) ? hysteresisMargin : 0;
          if (thumbPercentage < (straightThreshold + tolerance) && 
              indexPercentage < (straightThreshold + tolerance) && 
              middlePercentage > (bentThreshold - tolerance) && 
              ringPercentage < (straightThreshold + tolerance) && 
              pinkyPercentage < (straightThreshold + tolerance) &&
              a.acceleration.x > -3 && a.acceleration.x < 5 && a.acceleration.z > 6) {
            displayYrden();
            detectedThisLoop = YRDEN;
          }

          // ZARAZA
          else {
            tolerance = (activeSign == ZARAZA) ? hysteresisMargin : 0;
            if (thumbPercentage > (bentThreshold - tolerance) && 
                indexPercentage > (bentThreshold - tolerance) && 
                middlePercentage > (bentThreshold - tolerance) && 
                ringPercentage > (bentThreshold - tolerance) && 
                pinkyPercentage > (bentThreshold - tolerance)) {
              displayZaraza();
              detectedThisLoop = ZARAZA;
            }

            // CURSE
            else {
              tolerance = (activeSign == CURSE) ? hysteresisMargin : 0;
              if (indexPercentage > (bentThreshold - tolerance) && 
                  middlePercentage < (straightThreshold + tolerance) && 
                  ringPercentage > (bentThreshold - tolerance) && 
                  pinkyPercentage > (bentThreshold - tolerance)) {
                displayCurse();
                detectedThisLoop = CURSE;
              }

              // LAMBERT
              else {
                tolerance = (activeSign == LAMBERT) ? hysteresisMargin : 0;
                if (thumbPercentage < (straightThreshold + tolerance) && 
                    indexPercentage < (straightThreshold + tolerance) && 
                    middlePercentage > (bentThreshold - tolerance) && 
                    ringPercentage > (bentThreshold - tolerance) && 
                    pinkyPercentage > (bentThreshold - tolerance)) {
                  displayLambert();
                  detectedThisLoop = LAMBERT;
                }

                // STORM
                else {
                  tolerance = (activeSign == STORM) ? hysteresisMargin : 0;
                  if (thumbPercentage < (straightThreshold + tolerance) && 
                      indexPercentage > (bentThreshold - tolerance) && 
                      middlePercentage > (bentThreshold - tolerance) && 
                      ringPercentage > (bentThreshold - tolerance) && 
                      pinkyPercentage > (bentThreshold - tolerance) &&
                      a.acceleration.y > 7) {
                    displayStorm();
                    detectedThisLoop = STORM;
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  activeSign = detectedThisLoop;
  display.display();
  delay(25);
}
